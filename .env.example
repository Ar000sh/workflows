# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
# CLASSIFIER_MODEL=claude-haiku-4-5
# DRAFTER_MODEL=claude-sonnet-5-5
# DRAFTER_EFFORT=low
# AUTO_REPLY_MODE=always      # or: outside_hours
# Layer 4a: database (defaults shown; docker-compose.yml publishes Postgres on port 5433)
# DATABASE_URL=postgresql+psycopg://leads:leads@localhost:5433/leads
# DATABASE_URL_TEST=postgresql+psycopg://leads:leads@localhost:5433/leads_test
# RETENTION_DAYS=90           # personal data is blanked after this many days
# Layer 4b: outgoing mail (defaults shown point at Mailpit from docker-compose.yml)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TIMEOUT_SECONDS=10
# MAIL_FROM=                  # empty = the practice email from data/practice.yaml
# Layer 4b: intake limits (services/intake.py)
# MAX_LEADS_PER_EMAIL_HOUR=3   # more leads than this from one mailbox in an hour: saved, no email, no AI
# MAX_LEADS_PER_EMAIL_DAY=10   # the same per day
# MAX_AI_LEADS_PER_HOUR=60     # above this many leads an hour: fixed acknowledgment, no AI (bounds API spend)
# MAX_CONCURRENT_PIPELINES=10  # AI runs at once; with none free a lead gets the fixed acknowledgment
# PIPELINE_DEADLINE_SECONDS=45 # an AI run slower than this is given up for the fixed acknowledgment
# Layer 4b: the sweep (scripts/run_sweep.py)
# SENDING_TIMEOUT_MINUTES=10  # an acknowledgment stuck in "sending" longer than this is resent
# MAX_SEND_ATTEMPTS=3         # claims in all before a stuck acknowledgment is left for staff
# NO_REPLY_SWEEP_MINUTES=5    # a lead older than this with no first reply gets the fallback acknowledgment; an unsent first reply this old is sent
