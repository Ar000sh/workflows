# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
# CLASSIFIER_MODEL=claude-haiku-4-5
# DRAFTER_MODEL=claude-sonnet-5-5
# DRAFTER_EFFORT=low
# AUTO_REPLY_MODE=always      # or: outside_hours
# Layer 4a: database (defaults shown; docker-compose.yml publishes Postgres on port 5433)
# DATABASE_URL=postgresql+psycopg://leads:leads@localhost:5433/leads
# DATABASE_URL_TEST=postgresql+psycopg://leads:leads@localhost:5433/leads_test
# RETENTION_DAYS=90           # personal data is blanked after this many days
